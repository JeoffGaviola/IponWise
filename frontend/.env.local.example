# Copy this file to .env.local and replace these values with your own configuration.
# Google/Facebook OAuth client IDs and secrets are configured only in Supabase Auth provider settings; never put them here.
# Never commit frontend/.env.local. VITE_ variables are public in the browser bundle;
# only use a Supabase publishable/anon key here, never a service-role or database key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPPORT_EMAIL=YOUR_SUPPORT_EMAIL
