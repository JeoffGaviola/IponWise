# Copy this file to .env.local and replace the placeholders. Never commit .env.local.
# Without the two Supabase values the sign-in screen shows a "not configured" notice and no account
# actions work; IponWise has no fake/demo data mode.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# FastAPI base URL (no trailing slash). Use your deployed API URL in production.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPPORT_EMAIL=YOUR_SUPPORT_EMAIL
