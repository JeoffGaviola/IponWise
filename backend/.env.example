# Supabase PostgreSQL connection string from Project Settings > Database.
# Use the session/transaction pooler URL appropriate for your deployment.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/postgres?sslmode=require

# Supabase project settings; used by FastAPI to validate access tokens via Supabase Auth.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Comma-separated exact frontend origins; add your production domain before deployment.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
# Server-side Gemini key for the optional, read-only savings assistant. Never expose it to React.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Change this only to a Gemini model available to your API key.
GEMINI_MODEL=gemini-2.5-flash
# Server-side only. Never expose this key to the React frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
